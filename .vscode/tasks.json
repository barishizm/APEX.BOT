{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web: dev",
      "detail": "Ana sayfayı http://localhost:3000 adresinde canlı yeniden yüklemeyle çalıştırır",
      "type": "shell",
      "command": "npm run dev:web",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 },
      "presentation": { "reveal": "silent", "panel": "dedicated", "group": "dev" },
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^\\s*(error|Error).*$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Next\\.js",
          "endsPattern": "Ready in"
        }
      }
    }
  ]
}
