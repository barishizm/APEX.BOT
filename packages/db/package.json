{
  "name": "@apex/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bot-settings": "./src/bot-settings.ts",
    "./flags": "./src/flags.ts",
    "./plans": "./src/plans.ts",
    "./entitlements": "./src/entitlements.ts",
    "./migrate": "./src/migrate.ts",
    "./pii": "./src/pii.ts"
  },
  "scripts": {
    "migrate": "tsx --env-file-if-exists=../../apps/web/.env.local src/migrate.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=../../apps/web/.env.local src/admin-bootstrap.ts",
    "billing:beta-placement": "tsx --env-file-if-exists=../../apps/web/.env.local src/beta-placement-cli.ts",
    "local": "tsx src/local-server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
