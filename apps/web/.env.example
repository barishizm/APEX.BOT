# Copy to .env.local (git-ignored) and fill in.

# PostgreSQL connection string. Supabase: Project Settings → Database → Connection string,
# "Session pooler" (works over IPv4). Any PostgreSQL 13+ server works the same way:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# TLS: "require" (default for non-localhost hosts) encrypts without verifying the
# certificate; "verify" also verifies, using DATABASE_CA_CERT (PEM text) if set;
# "off" for a local server without TLS.
DATABASE_SSL=
DATABASE_CA_CERT=

# Number of proxy hops in front of the app (Vercel = 1, none = 0). The client IP is the
# Nth entry from the right of X-Forwarded-For. With 0 the per-IP login limit does not apply,
# so set 1 on Vercel.
TRUST_PROXY=0

# Sign in with Google / GitHub. Leave empty to keep the buttons disabled.
# Redirect URI to register with each provider: <NEXT_PUBLIC_SITE_URL>/api/auth/oauth/google/callback
# (and .../github/callback). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of the chat API (apps/api). The dashboard's embed code loads
# <this>/widget.js. Local dev: http://localhost:8787
NEXT_PUBLIC_APEX_API_URL=http://localhost:8787

# Site key of the bot that runs as the live demo on this site (dashboard → Install). Its allowed
# origins must include this site's host. Empty: the demo key locally, no widget in production.
NEXT_PUBLIC_APEX_SITE_KEY=

# Address shown as "Contact" on the marketing site and in the legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Transactional email (verification and password reset codes) through Resend.
# Without a key, development prints the emails to the server log.
RESEND_API_KEY=

# Lets /admin/system read the chat API's /health/details (sent as the x-apex-health-token header).
# The same random secret as APEX_HEALTH_TOKEN on the chat API: openssl rand -base64 32
APEX_HEALTH_TOKEN=

# Encrypts two-step sign-in (authenticator) secrets in the database. 32 random bytes, base64:
#   openssl rand -base64 32
# Required to turn two-step sign-in on and to sign in with it. Never change it once set: secrets
# encrypted with the old key stop opening and those users can only sign in with a recovery code.
TOTP_ENCRYPTION_KEY=

# Who may sign up until staff choose in /admin/settings: open (default), invite_only or closed.
# Only a default: the setting in the admin area wins once it is saved.
SIGNUPS_MODE=
MAIL_FROM="Apex Bot <no-reply@your-domain.com>"

# Local development only: let the knowledge crawler read sites on your own machine/network.
APEX_CRAWL_ALLOW_PRIVATE=0
# Retrieval floor shown in the dashboard's "Try a question"; keep equal to the chat API's value.
APEX_MIN_RETRIEVAL_SCORE=2
# Matching by meaning in "Try a question": the chat API's APEX_EMBEDDINGS and its key. Leave empty for
# a keyword-only preview. The vectors themselves are written by the chat API.
APEX_EMBEDDINGS=
GEMINI_API_KEY=

# Cloudflare Turnstile (bot check on sign-up). Cloudflare dashboard → Turnstile → Add widget,
# hostnames: your domain (+ localhost for dev). Leave both empty to turn the check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
