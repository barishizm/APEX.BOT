# Copy to .env.local (git-ignored) and fill in.

# PostgreSQL connection string. Supabase: Project Settings → Database → Connection string,
# "Session pooler" (works over IPv4). Any PostgreSQL 13+ server works the same way:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# TLS: "require" (default for non-localhost hosts) encrypts without verifying the
# certificate; "verify" also verifies, using DATABASE_CA_CERT (PEM text) if set;
# "off" for a local server without TLS.
DATABASE_SSL=
DATABASE_CA_CERT=

# Only behind a proxy you control (Vercel, your own nginx): trust X-Forwarded-For
# for per-IP login throttling.
TRUST_PROXY=0

# Sign in with Google / GitHub. Leave empty to keep the buttons disabled.
# Redirect URI to register with each provider: <NEXT_PUBLIC_SITE_URL>/api/auth/oauth/google/callback
# (and .../github/callback). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
