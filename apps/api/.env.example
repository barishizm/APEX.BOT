# Claude API key (or sign in once with `ant auth login` and leave this unset).
ANTHROPIC_API_KEY=
# Chat model; "echo" streams the top retrieved excerpt instead (local dev, no API key).
APEX_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
APEX_EFFORT=medium
APEX_MAX_OUTPUT_TOKENS=8000
# Server-side refusal fallbacks: Claude API only, not supported on Haiku. Set "on" with a Sonnet/Opus model.
APEX_FALLBACKS=off
# BM25 floor for the "I don't know" path; tune with the eval set.
APEX_MIN_RETRIEVAL_SCORE=2
PORT=8787
# Only behind a proxy you control: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=0
