# Claude API key (or sign in once with `ant auth login` and leave this unset).
ANTHROPIC_API_KEY=
# Keys for the providers tenants can pick in the dashboard (Customize widget → AI model).
OPENAI_API_KEY=
GEMINI_API_KEY=
# Same database as apps/web: dashboard bots are synced from it every 30 s. Leave empty to
# serve only the tenants in data/tenants.json.
DATABASE_URL=
DATABASE_SSL=
# Default chat model for tenants without a dashboard choice; "echo" streams the top retrieved excerpt instead (local dev, no API key).
APEX_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
APEX_EFFORT=medium
APEX_MAX_OUTPUT_TOKENS=8000
# Server-side refusal fallbacks: Claude API only, not supported on Haiku. Set "on" with a Sonnet/Opus model.
APEX_FALLBACKS=off
# BM25 floor for the "I don't know" path; tune with the eval set.
APEX_MIN_RETRIEVAL_SCORE=2
PORT=8787
# Only behind a proxy you control: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=0
# Hand-off and lead emails through Resend; without a key they are only logged (development).
RESEND_API_KEY=
MAIL_FROM="Apex Bot <no-reply@your-domain.com>"
